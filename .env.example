# Copy this file to .env and edit it. Defaults work for local development.

# false = local Ollama (llama3) for text and local SDXL for images
# true  = GPT-4o for text and DALL-E 3 for images (needs OPENAI_API_KEY, costs money)
USE_OPENAI=false
OPENAI_API_KEY=

# Where the ChromaDB vector store is kept
CHROMA_PATH=./chroma_db
